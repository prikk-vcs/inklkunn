exact :: request.rs :: parameter :: the name of a placeholder of a catalog message and of the member that carries the same value
exact :: request.rs :: view :: the name of a placeholder of a catalog message and of the member that carries the same value
exact :: request.rs :: feature :: the name of the member that says which read is not offered
