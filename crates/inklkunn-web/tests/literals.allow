# The allowlist of tests/catalog_checks.rs (RFC 003 D-6; planeter RFC 012 D-5): every literal of a product source
# or a template that looks like words and is NOT a catalog message, with the reason. Reviewed like code: a line
# added here is a decision, and a line nothing matches fails the build.
#
# kind :: file :: literal :: reason
#   scope   a source file that is not scanned at all (the file's name; the literal column is `*`)
#   exact   a literal, as the scanner reads it and trimmed (the file's name, or `*` for any file)
#   prefix  every literal that starts with the given text (the file's name, or `*`)
#   safe    a template expression that may be printed with `|safe` (the template's name)
#
# A literal "looks like words" when it holds three ASCII letters in a row or any letter that is not ASCII. The
# files that build a response a reader sees (`pages.rs`, `style.rs`, `probe.rs`, `origin.rs`) are scanned and
# list what they hold; the files below are scoped because nothing in them is a sentence a reader sees.

# --- files with no sentence a reader sees
scope :: catalog.rs :: * :: the catalog's own machinery: language tags and endonyms, the identifiers of the keys, the markup of the typed slots and its escaping; the messages are the tables in catalog/
scope :: config.rs :: * :: start-up refusals printed for the person who runs the server before a socket is opened (English by decision: operator vocabulary, like a log line); no response carries them
scope :: serve.rs :: * :: operator-facing errors of binding and serving, printed at start; no response carries them
scope :: headers.rs :: * :: header names and values, policy directives and the cache and vary tokens; nothing a reader sees
scope :: lang.rs :: * :: the cookie and header names, the addresses a language switch never copies, and the cookie's format; it builds no sentence
scope :: routes.rs :: * :: the route registry: paths, methods and the public reasons written for the reviewer of the route table; no response carries them, and no handler is defined here

# --- pages.rs: the handlers and the layout's data
exact :: pages.rs :: /-/lang :: the address of the language page, which every switcher form posts to
exact :: pages.rs :: version :: a placeholder name of a catalog message
exact :: pages.rs :: name :: a placeholder name of a catalog message
exact :: pages.rs :: next :: the name of the form field and of the query parameter that carry the return address
exact :: pages.rs :: lang :: the name of the form field that carries the language code
exact :: pages.rs :: text/html; charset=utf-8 :: a media type
exact :: pages.rs :: text/plain; charset=utf-8 :: a media type

# --- style.rs: the stylesheet's route
exact :: style.rs :: ../static/site.css :: the path of the file embedded with include_str!
exact :: style.rs :: /-/assets/{file} :: the route pattern of the stylesheet
exact :: style.rs :: /-/assets/{} :: the address the pages link to
exact :: style.rs :: site-{:016x}.css :: the file name, made of the sheet's fingerprint
exact :: style.rs :: text/css; charset=utf-8 :: a media type
exact :: style.rs :: public, max-age=31536000, immutable :: a Cache-Control value
exact :: style.rs :: Accept-Encoding :: a Vary token

# --- T4: the wiki's pages (handoff 003)
scope :: present.rs :: * :: the URL scheme of a wiki's pages and the names of the placeholders of catalog messages; every sentence it returns is a catalog message
scope :: url.rs :: * :: the URL scheme (view and title addresses and percent-escapes); it builds no sentence a reader sees
scope :: services.rs :: * :: the services a handler holds; its only literal is the name of its Debug output
exact :: time.rs :: {year:04}-{month:02}-{day:02} {:02}:{:02} UTC :: the format of a moment (a date, a time and the unit UTC), data in a sentence the catalog builds around it
exact :: wiki.rs :: /-/wikis :: the address of the list of wikis, which every wiki page's navigation links to
exact :: wiki.rs :: {base}/-/about :: an address of the wiki's own surfaces (RFC 003 D-1)
exact :: wiki.rs :: {base}/-/verification :: an address of the wiki's own surfaces (RFC 003 D-1)
exact :: wiki.rs :: /{}/-/verification :: an address of the wiki's own surfaces (RFC 003 D-1)
exact :: wiki.rs :: /{}/Home :: the address of a wiki's start page: the page titled Home (RFC 003 D-1)
exact :: wiki.rs :: /{}/-/about :: the address of a wiki's about page, where a wiki with no Home page starts
exact :: wiki.rs :: Home :: the title of the page a wiki starts at; a title is the wiki's own data, not a sentence of this site
exact :: wiki.rs :: heads/ :: the prefix of a view's name in the repository, taken off for the address
exact :: wiki.rs :: state :: a placeholder name of a catalog message
exact :: wiki.rs :: page :: a placeholder name of a catalog message
exact :: wiki.rs :: wiki :: a placeholder name of a catalog message
exact :: wiki.rs :: title :: a placeholder name of a catalog message
exact :: wiki.rs :: target :: a placeholder name of a catalog message
exact :: wiki.rs :: view :: a placeholder name of a catalog message
exact :: wiki.rs :: license :: a placeholder name of a catalog message
exact :: wiki.rs :: when :: a placeholder name of a catalog message
exact :: wiki.rs :: a page of wiki `{}` could not be read now: {cause} :: a line for the person who runs the server (English by decision: operator vocabulary); no response carries it
exact :: wiki.rs :: a verification of wiki `{}` could not be completed: {why} :: a line for the person who runs the server (English by decision: operator vocabulary); no response carries it

# --- T8: the read API (handoff 003)
scope :: api.rs :: * :: the API's prefixes, the description's path and the media types: addresses and media types, no sentence
scope :: problem.rs :: * :: the registry of problem codes: stable identifiers, the form of the URN and the standard's member names; every sentence a problem says is a catalog message chosen by `Code::keys` (the tests in problem/tests.rs hold that)
scope :: reply.rs :: * :: media types and the `Link` header's fixed value; no sentence
scope :: endpoints.rs :: * :: the JSON member names of the answers, the registry's public reasons (written for the reviewer of the route table), the names of query parameters and an operator's log line; every sentence a caller reads is a problem detail in problem.rs
scope :: describe.rs :: * :: the OpenAPI document's descriptions: English by decision, the reference a programmer reads (like an operator's log line); the problem details a caller gets are catalog messages in the caller's language
scope :: openapi.rs :: * :: the OpenAPI document's structure and descriptions: English by decision, like describe.rs; machine-readable member names
exact :: request.rs :: api :: a segment of the API's address
exact :: request.rs :: parameter :: the name of a placeholder of a catalog message and of the member that carries the same value
exact :: request.rs :: view :: the name of a placeholder of a catalog message and of the member that carries the same value
exact :: request.rs :: feature :: the name of the member that says which read is not offered
exact :: request.rs :: heads/ :: the prefix of a view's name in the repository, taken off for the answer
exact :: request.rs :: the API could not read wiki `{}` now: {cause} :: a line for the person who runs the server (English by decision: operator vocabulary); no response carries it
# --- T5: a page's past (handoff 003): the history, change, difference and permalink handlers
exact :: history.rs :: view :: the name of a query parameter, and a placeholder name of a catalog message
exact :: history.rs :: after :: the name of the query parameter that says where in a history to go on from
exact :: history.rs :: heads/ :: the prefix of a view's name in the repository, taken off for the address
exact :: history.rs :: {what} of wiki `{}` could not be read now: {cause} :: the operator's log line for a read that could not be made (a log, not a page)
exact :: history.rs :: a page's history :: what the operator's log line above was about (a log, not a page)
exact :: history.rs :: a change :: what the operator's log line above was about (a log, not a page)
exact :: history.rs :: a difference :: what the operator's log line above was about (a log, not a page)
exact :: history.rs :: a page at a change :: what the operator's log line above was about (a log, not a page)
exact :: history.rs :: token :: a placeholder name of a catalog message
exact :: history.rs :: name :: a placeholder name of a catalog message
exact :: history.rs :: number :: a placeholder name of a catalog message
exact :: history.rs :: title :: a placeholder name of a catalog message
exact :: history.rs :: page :: a placeholder name of a catalog message
exact :: history.rs :: wiki :: a placeholder name of a catalog message
exact :: history.rs :: proposer :: a placeholder name of a catalog message
exact :: history.rs :: acceptor :: a placeholder name of a catalog message
exact :: history.rs :: from :: a placeholder name of a catalog message
exact :: history.rs :: line :: a placeholder name of a catalog message
exact :: history.rs :: limit :: a placeholder name of a catalog message
exact :: history.rs :: change :: a placeholder name of a catalog message
exact :: history.rs :: current :: a placeholder name of a catalog message
