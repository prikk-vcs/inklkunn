exact :: style.rs :: /-/assets/{file} :: the route pattern of the stylesheet
exact :: style.rs :: /-/assets/{} :: the address the pages link to
exact :: style.rs :: site-{:016x}.css :: the file name, made of the sheet's fingerprint
exact :: style.rs :: text/css; charset=utf-8 :: a media type
exact :: style.rs :: public, max-age=31536000, immutable :: a Cache-Control value
exact :: style.rs :: Accept-Encoding :: a Vary token

# --- T4: the wiki's pages (handoff 003)
scope :: present.rs :: * :: the URL scheme of a wiki's pages and the names of the placeholders of catalog messages; every sentence it returns is a catalog message
scope :: url.rs :: * :: the URL scheme (view and title addresses and percent-escapes); it builds no sentence a reader sees
scope :: services.rs :: * :: the services a handler holds; its only literal is the name of its Debug output
exact :: time.rs :: {year:04}-{month:02}-{day:02} {:02}:{:02} UTC :: the format of a moment (a date, a time and the unit UTC), data in a sentence the catalog builds around it
